/* NFS0 - mount a Linux NFSv3 export via nfs-handler.
 * Drop in DEVS:DOSDrivers (with an icon) for automount, or keep in
 * SYS:Storage/DOSDrivers and 'Mount NFS0:' by hand.
 * Startup is "host:/export/path"; host is a dotted quad for now. */
Handler    = L:nfs-handler
StackSize  = 16384
Priority   = 5
GlobVec    = -1
Startup    = "192.168.68.117:/home/creep/nfs-share"
